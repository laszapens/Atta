# --- Atta runtime state -------------------------------------------------------
# The workspace Atta writes into (models.json, out/, cache/, blender jobs).
# Can be relocated with ATTA_HOME; never commit it.
_atta/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Node / DSH plugin -------------------------------------------------------
node_modules/
npm-debug.log*
pnpm-debug.log*
lib/.build.lock
lib/.build-ok

# --- Generated artifacts -----------------------------------------------------
# Machine-specific MCP config produced by `python3 -m atta.agent.install`.
# The template is plugins/atta/.mcp.json.example.
plugins/atta/.mcp.json

# Third-party corpus material.
# corpus/normalized/ IS shipped: it is the evidence behind the coverage and
# reuse numbers, and its contents are redistributable -- the 352 records that
# carry third-party source are entirely BSD-2-Clause / BSD-3-Clause / Apache-2.0
# / MIT / CC0-1.0 (no copyleft), and the 7 NOASSERTION rows are dataset index
# entries with no code and no geometry. Per-record provenance (url, commit,
# licence) travels with every row; see corpus/README.md.
# Still excluded: the raw snapshots and the rejected candidates.
corpus/raw/
corpus/rejected/
corpus/nominations.jsonl

# Blender / export by-products
*.blend1
*.blend2
*.tmp
renders/
*.step

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
